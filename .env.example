# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend URL for the website (Vercel env). Your Railway public address, no trailing slash.
RAILWAY_API_URL=

# Alerts
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# Webhook signing (SchemaZero outbound webhook signing secret)
SCHEMAZERO_WEBHOOK_SIGNING_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@schemazero.com

# AI
ANTHROPIC_API_KEY=

# Encryption (AES-256 key — 32 bytes, base64-encoded)
ENCRYPTION_KEY=

# Internal service secret (Scout → Zero HTTP calls)
INTERNAL_API_SECRET=
# Leave INTERNAL_API_URL unset: Scout defaults to this app's own port.
# INTERNAL_API_URL=

# App URLs
FRONTEND_URL=https://schemazero.com
DASHBOARD_URL=https://app.schemazero.com

# Admin panel — comma-separated emails that can access /admin
# Managed SaaS: set this to the founder/ops email(s)
# Self-hosted: set this to the instance owner's email
ADMIN_EMAIL=you@yourdomain.com
